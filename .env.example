# Copy this file to .env and fill in what you need. NEVER commit .env.

# ── Recaps every 4h (pick one or both) ───────────────────────────────────────
# Telegram: talk to @BotFather -> /newbot -> paste the token here.
# Then send any message to your bot and open
# https://api.telegram.org/bot<TOKEN>/getUpdates to read your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord: Server settings -> Integrations -> Webhooks -> New webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# ── Optional: Claude reads token websites (legit & "tasty" check) ────────────
ANTHROPIC_API_KEY=

# ── Optional but recommended for live: a private RPC (Helius, QuickNode, Triton)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── LIVE ONLY ────────────────────────────────────────────────────────────────
# Use a NEW, dedicated wallet funded only with what you can afford to lose.
# Phantom: Settings -> Manage accounts -> (account) -> Show private key.
WALLET_PRIVATE_KEY=
# Must be exactly I_ACCEPT_THE_RISK for live mode to start.
LIVE_CONFIRM=
